{
  "name": "@dash-builder/core",
  "version": "0.0.0",
  "description": "Framework-agnostic dashboard grid: draggable, resizable widgets that flow into a fixed number of columns. Zero dependencies.",
  "license": "MIT",
  "author": "Konstantin Penzin",
  "homepage": "https://constantine-24.github.io/dash-builder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constantine-24/dash-builder.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Constantine-24/dash-builder/issues"
  },
  "keywords": [
    "dashboard",
    "grid",
    "layout",
    "widgets",
    "drag-and-drop",
    "resizable",
    "draggable",
    "vanilla",
    "framework-agnostic",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grid.css": "./dist/grid.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:smoke": "pnpm build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
