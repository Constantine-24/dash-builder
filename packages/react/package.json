{
  "name": "@dash-builder/react",
  "version": "0.0.0",
  "description": "React bindings for @dash-builder/core: a dashboard grid with draggable, resizable widgets in a fixed number of columns.",
  "license": "MIT",
  "author": "Konstantin Penzin",
  "homepage": "https://constantine-24.github.io/dash-builder/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constantine-24/dash-builder.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Constantine-24/dash-builder/issues"
  },
  "keywords": [
    "dashboard",
    "grid",
    "layout",
    "widgets",
    "drag-and-drop",
    "resizable",
    "draggable",
    "react"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "vite",
    "build:demo": "vite build",
    "test:smoke": "pnpm build && node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@dash-builder/core": "workspace:0.x",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dash-builder/core": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
